                    <h3><i class="fas fa-bed"></i> Características</h3>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Cantidad de Baños</label>
                                <input type="number" class="form-control" placeholder="0" min="0">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Cantidad de Camas</label>
